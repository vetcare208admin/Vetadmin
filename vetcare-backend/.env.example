# Runtime Environment
NODE_ENV=production
PORT=3001

# Database (use Neon.tech or Supabase for Vercel)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (use Upstash for Vercel — https://upstash.com)
# Leave blank to disable queues (app will still run without queues)
REDIS_URL=rediss://default:password@host:port

# JWT Configuration
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-256-bit-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://vetadmin-vetcare-frontend.vercel.app

# AWS S3 (optional — for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email / SMTP (optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=no-reply@vetcare.com

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS / Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
