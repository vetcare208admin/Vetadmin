{
  "name": "vetcare-platform",
  "version": "1.0.0",
  "description": "VetCare Platform - Full-Stack Multi-Module Veterinary SaaS",
  "private": true,
  "workspaces": [
    "vetcare-backend",
    "vetcare-frontend"
  ],
  "scripts": {
    "dev:backend": "cd vetcare-backend && npm run start:dev",
    "dev:frontend": "cd vetcare-frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "cd vetcare-backend && npm run build",
    "build:frontend": "cd vetcare-frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "cd vetcare-backend && npm test",
    "test:frontend": "cd vetcare-frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:migrate": "cd vetcare-backend && npx prisma migrate dev",
    "db:generate": "cd vetcare-backend && npx prisma generate",
    "db:studio": "cd vetcare-backend && npx prisma studio",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd vetcare-backend && npm run lint",
    "lint:frontend": "cd vetcare-frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
